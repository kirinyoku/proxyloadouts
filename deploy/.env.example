# ==============================================================================
# ProxyLoadouts Deploy Environment Configuration
# ==============================================================================
# Copy this file to .env before deploying to production:
#   cp .env.example .env

# Application environment mode: development (for localhost) or production (for live server)
ENV=production

# Origin URL of the frontend client application.
FRONTEND_URL=

# Mandatory in production: generate 32+ bytes key (e.g. openssl rand -hex 32)
SESSION_SECRET=

# Discord OAuth2 application credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Optional: Telegram Bot alerting for Backend (500/panics/lifecycle) and Frontend errors
# Create a bot via @BotFather and specify your personal or group chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Forum topic thread ID if sending to a Telegram supergroup with topics
TELEGRAM_THREAD_ID=

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Internal Admin Console port inside container (mapped to 127.0.0.1:8889 on host)
ADMIN_PORT=8081
