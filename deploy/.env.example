# ==============================================================================
# ProxyLoadouts Deploy Environment Configuration
# ==============================================================================
# Copy this file to .env before deploying to production:
#   cp .env.example .env

# Application environment mode: development (for localhost) or production (for live server)
ENV=production

# Origin URL of the frontend client application.
FRONTEND_URL=

# Mandatory in production: generate 32+ bytes key (e.g. openssl rand -hex 32)
SESSION_SECRET=

# Discord OAuth2 application credentials
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=

# Optional: Sentry error tracking for Backend (Go)
SENTRY_DSN=

# Optional: Dedicated Sentry DSN for Frontend (React SPA).
# If omitted or left empty, Docker build will automatically fallback to SENTRY_DSN above.
VITE_SENTRY_DSN=

# Log level: debug, info, warn, error
LOG_LEVEL=info
