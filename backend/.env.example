# ==============================================================================
# ProxyLoadouts Backend Environment Configuration
# ==============================================================================
# Copy this template to .env to configure your local runtime:
#   cp .env.example .env
#
# In production, ensure all credentials are provided via secure environment
# variables or container secret mounts. Never commit .env files to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. HTTP Server Runtime
# ------------------------------------------------------------------------------
# Port on which the HTTP server listens.
PORT=8080

# Port on which the internal Admin Console listens (set to "off" or "0" to disable).
# In production Docker Compose, mapped to 127.0.0.1:8889 for SSH port-forwarding.
ADMIN_PORT=8081

# Application environment mode:
# - development: relaxed security, verbose logs, dev cookie flags (HTTP allowed).
# - production:  enforces mandatory secrets, strict cookie security (Secure, __Host-),
#                and rejects default dev credentials during startup validation.
ENV=development

# ------------------------------------------------------------------------------
# 2. Database Persistence (SQLite)
# ------------------------------------------------------------------------------
# Path to the SQLite database file.
# The parent directory will be created automatically if it does not exist.
# Connection executes in WAL mode (Write-Ahead Logging) with busy_timeout=5000ms.
DATABASE_PATH=./data/proxyloadouts.db

# ------------------------------------------------------------------------------
# 3. Security & Authenticated Sessions
# ------------------------------------------------------------------------------
# Encryption and HMAC signing key for user session cookies (AES-256-GCM).
# REQUIRED in production: Server will refuse to boot with default secrets.
# Generate a secure 32-byte secret using: openssl rand -hex 32
SESSION_SECRET=dev-session-secret-change-in-production-min32chars

# ------------------------------------------------------------------------------
# 4. Discord OAuth2 Authentication
# ------------------------------------------------------------------------------
# OAuth2 application credentials from: https://discord.com/developers/applications
# In development, leave blank if testing only public showcase endpoints.
# In production, these are mandatory for user login and account linking.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Callback redirect URI registered in your Discord Developer Application settings:
# Development default: http://localhost:8080/api/v1/auth/discord/callback
# Production example:  https://api.yourdomain.com/api/v1/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:8080/api/v1/auth/discord/callback

# ------------------------------------------------------------------------------
# 5. Frontend & CORS Policy
# ------------------------------------------------------------------------------
# Origin URL of the frontend client application.
# Used for CORS allowlisting, OAuth post-login redirect, and CSRF origin verification.
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Upstream Game Services (EnkaNetwork & Fairy SDK)
# ------------------------------------------------------------------------------
# HTTP client timeout in seconds when querying upstream EnkaNetwork API.
ENKA_TIMEOUT=15

# ------------------------------------------------------------------------------
# 7. Performance Tuning, Rate Limiting & In-Memory Caches (Optional)
# ------------------------------------------------------------------------------
# Uncomment and adjust these to fine-tune performance under heavy load.
# Defaults shown below are calibrated for typical production usage.

# Token-bucket rate limiting for public showcase fetch endpoints (per client IP):
# SHOWCASE_RATE_LIMIT_PER_MINUTE=20
# SHOWCASE_RATE_LIMIT_BURST=5

# Maximum capacity for in-memory LRU profile cache (stores upstream Enka payloads):
# PROFILE_CACHE_MAX_ITEMS=1000

# Capacity for negative cache (prevents hammering Enka for UIDs with no showcase):
# NEGATIVE_CACHE_MAX_ITEMS=5000

# Maximum capacity for memoized localized builds (Fairy enrichment singleflight):
# BUILD_ENRICH_CACHE_MAX_ITEMS=2000

# Expiration TTL in seconds for memoized localized builds (default: 15 minutes):
# BUILD_ENRICH_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------------------------
# 8. Observability, Alerting & Logging (Optional)
# ------------------------------------------------------------------------------
# Telegram Bot token and target Chat ID for real-time error, panic, and lifecycle alerts:
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# TELEGRAM_CHAT_ID=123456789
# TELEGRAM_THREAD_ID=0

# Structured log verbosity level: debug, info, warn, error (default: info).
# Emits structured JSON to stdout, filtered by this threshold.
LOG_LEVEL=info

